{
  "name": "wallet-app-v1",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:stubbed": "cypress run --spec \"cypress/e2e/stubbed/**/*.cy.ts\"",
    "cy:run:real": "cypress run --spec \"cypress/e2e/real/**/*.cy.ts\"",
    "e2e": "start-server-and-test dev:e2e http://localhost:5173 cy:run",
    "e2e:stubbed": "start-server-and-test dev:e2e http://localhost:5173 cy:run:stubbed",
    "e2e:real": "start-server-and-test dev:e2e http://localhost:5173 cy:run:real",
    "e2e:open": "start-server-and-test dev:e2e http://localhost:5173 cy:open"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@unovis/vue": "^1.6.7",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "cypress": "^16.1.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.2.0"
  }
}
